# Copy to app\.env:   copy .env.example .env
# Read by docker compose (app\.env) AND by the backend when run outside Docker.
# DEV ONLY values. Never commit a real .env.

# --- Postgres (docker compose) ----------------------------------------------------------
POSTGRES_USER=benki
POSTGRES_PASSWORD=benki-dev-only
POSTGRES_DB=benki
# Host port for Postgres (localhost only). Change if a local Postgres already uses 5432.
DB_PORT=5432
# Host port for the backend API (localhost only). The frontend is always on 3000.
BACKEND_PORT=8000

# --- Backend ----------------------------------------------------------------------------
# Used only when the backend runs on the host; in Docker, compose builds it from POSTGRES_*.
DATABASE_URL=postgresql+psycopg://benki:benki-dev-only@localhost:5432/benki
# HS256 signing key, at least 16 characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
# Comma-separated browser origins allowed to call the API directly (Vite dev server, nginx).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# gemma = the real EmbeddingGemma router (needs HF_CACHE_DIR / the model in the HF cache)
# stub  = keyword stand-in, no model (frontend dev, CI)
ROUTER_MODE=gemma
LOG_LEVEL=INFO

# --- Model (docker compose) ---------------------------------------------------------------
# Your Hugging Face cache folder (contains hub\models--google--embeddinggemma-...), mounted read-only.
HF_CACHE_DIR=C:\Users\<your-user>\.cache\huggingface
# false = smaller image without torch; only ROUTER_MODE=stub will work.
INSTALL_GEMMA=true

# --- Optional backend tuning (defaults shown) -----------------------------------------------
# INTENT_ROUTER_DIR=..\..\intent-router      # default: the intent-router folder next to app\
# GEMMA_BACKEND=gemma
# GEMMA_LOCAL_ONLY=true                       # never contact the Hugging Face Hub
# PENDING_ACTION_TTL_SECONDS=300
# MAX_TRANSFER_AMOUNT=1000000
# MINI_STATEMENT_LIMIT=10
# FULL_STATEMENT_DEFAULT_MONTHS=3
# BANK_UTC_OFFSET_HOURS=3
# BCRYPT_ROUNDS=12
# SEED_DEV_PASSWORD=password123               # DEV ONLY: password of the seeded test users
# SEED_HISTORY_MONTHS=6
